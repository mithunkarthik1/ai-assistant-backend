# For running backend inside Docker:
DATABASE_URL=postgresql+psycopg://postgres:12345678@host.docker.internal:5432/chatbot_db
# For running backend locally outside Docker:
# DATABASE_URL=postgresql+psycopg://postgres:12345678@localhost:5432/chatbot_db
APP_NAME=RAG Chatbot API
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
POLICY_FILE_PATH=data/company_policy.txt
