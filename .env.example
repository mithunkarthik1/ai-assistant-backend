# For running backend inside Docker (connected to dedicated pgvector container):
DATABASE_URL=postgresql+psycopg://postgres:password123@db:5432/rag_db
# For running backend locally outside Docker:
# DATABASE_URL=postgresql+psycopg://postgres:password123@localhost:5433/rag_db
APP_NAME=RAG Chatbot API
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4
LLM_API_KEY=your_api_key_here
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
POLICY_FILE_PATH=data/company_policy.txt

# Agentic AI POC configuration (OpenAI-compatible providers, including local Ollama)
# AGENT_LLM_API_KEY=your_api_key_here
# AGENT_LLM_MODEL=gpt-4o-mini
# AGENT_LLM_BASE_URL=https://api.openai.com/v1
PROJECT_API_BASE_URL=http://localhost:9000
PROJECT_API_PATH_PREFIX=/projects
PROJECT_API_TIMEOUT_SECONDS=5
AGENT_MEMORY_MAX_MESSAGES=12
