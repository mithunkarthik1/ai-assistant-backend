# ==============================================================================
# WorkPilot AI Assistant - Environment Configuration Template (.env.example)
# Duplicate this file to .env and provide your specific credentials/URLs.
# Everything is loaded dynamically from .env (no hardcoded settings).
# ==============================================================================

# Application Settings
APP_NAME="WorkPilot AI Assistant"
LOG_LEVEL=INFO
CORS_ORIGINS=*

# PostgreSQL Relational Database (Primary Source of Truth)
# Inside Docker: use host.docker.internal:5432
# Outside Docker: use localhost:5432
DATABASE_URL=postgresql+psycopg://postgres:your_password@host.docker.internal:5432/chatbot_db

# Qdrant Cloud Dedicated Vector Database
QDRANT_URL=https://your-cluster-id.eu-central-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=document_chunks

# Policy Document & Initial Knowledge Base
POLICY_FILE_PATH=data/WorkPilot_Company_Policy.pdf
POLICY_DOC_ID=00000000-0000-0000-0000-000000000002

# Chunking & Retrieval Parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=6
MIN_SIMILARITY=0.60

# Embeddings Configuration
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# LLM Configuration
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gemini-3.5-flash-lite
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Project API (Mock / Agentic Integration)
PROJECT_API_BASE_URL=http://mock_project_api:9000
PROJECT_API_PATH_PREFIX=/api/v1/projects
PROJECT_API_TIMEOUT_SECONDS=5.0
AGENT_MEMORY_MAX_MESSAGES=12
